public class Employee{ 
  public String name; 
  public double salary = 30000.0d;; 
  public String designation = "junior"; 
  double tax; 
   
  public void newEmployee(String name){ 
    this.name = name; 
  } 
   
  public void displayInfo(){ 
    System.out.println("Employee Name: "+name); 
    System.out.println("Employee Salary: "+salary+" Tk"); 
    System.out.println("Employee Designation: "+designation); 
  } 
   
  public void calculateTax(){ 
    if(salary <= 30000){ 
      System.out.println("No need to pay tax"); 
    } 
    else if(salary > 30000){ 
      tax = salary*0.3d; 
      System.out.println(name+" Tax Amount: "+tax); 
    } 
  } 
   
  public void promoteEmployee(String newPosition){ 
    if(newPosition.equals("senior")){ 
      salary += 25000.0d; 
      System.out.println(name+"  has been promoted to senior"); 
      System.out.println(" New Salary: "+salary+" Tk "); 
    } 
     
    else if(newPosition.equals("lead")){ 
      salary += 50000.0d; 
      System.out.println(name+"  has been promoted to lead"); 
      System.out.println(" New Salary: "+salary+" Tk "); 
    } 
    else if(newPosition.equals("manager")){ 
      salary += 75000.0d; 
      System.out.println(name+"  has been promoted to manager"); 
      System.out.println(" New Salary: "+salary+" Tk "); 
    } 
    this.designation = newPosition; 
  } 
} 
 
