public class University{
    public String name;
    public String country;
}

//package Lab-2;

public class UniversityTester {
    public static void main (String[]args){
        University uni1 = new University();
        University uni2 = new University();

        //1(a)
        System.out.println("location of uni1: "+uni1);
        System.out.println("location of uni2: "+uni2);
        if(uni1==uni2){
            System.out.println("Both the objects are in same location");
        }
        else{
            System.out.println("Both the objects are not in same location");
        }

        //1(b)
        uni1.name = "Imperial College London";
        uni1.country = "England";
        uni2.name = "Brac University";
        uni2.country = "Bangladesh";
        System.out.println("Both objects are of same value");
        if((uni1.name!=null && uni1.country!=null)||(uni2.name!=null && uni2.country!=null)){
            System.out.println(uni1.name +"\n"+uni1.country +"\n"+uni2.name +"\n"+uni2.country );
        }
        else{
            System.out.println("Both objects have not changed");
        }
        if(uni1.name.equals(uni2.name) && uni1.country.equals(uni2.country)){
            System.out.println("Both objects are of same value");
        }
        else{
            System.out.println("Both objects are not of same value");
        }
    }
}

