//Task-1
import java.util.Scanner;
public class t1{
    public static void main(String[]args){
        Scanner sc1 = new Scanner(System.in);
        int max = 0;
        int min = 1000000000;
        double avg = 0.0;
        int sum = 0;
        double count = 0.0;

        for(int i=0; i<10; i++){
            int num = sc1.nextInt();
            if(num>0 && num%2!=0){
                count++;
                sum += num;
                if(num>max){
                    max=num;
                }
                if(num<min){
                    min = num;
                }
            }
        }
        avg = sum/count;
        if(count==0){
            System.out.println("No odd positive numbers found");
        }
        else{
            System.out.println("Sum ="+sum);
            System.out.println("Maximum ="+max);
            System.out.println("Minimum ="+min);
            System.out.println("Average ="+avg);
        }
        sc1.close();
    }
}

//Task-2

import java.util.Scanner;
public class t2 {
    public static void main( String[]args){
        Scanner sc2 = new Scanner(System.in);
        int start = sc2.nextInt();
        int end = sc2.nextInt();
        int prime = 0;

        if(start>end){ //start = 150 and end = 100
            int temp = start;//150
            start = end;//100
            end = temp;//150
        }
        for(int i=start; i<=end; i++){
            int divisor = 0;
            for(int j=1; j<=i;j++){
                if(i%j==0){
                    divisor++;
                }
            } 
            if(divisor==2){
                prime++;
            }
        }
        System.out.println("There are "+prime+" prime numbers between "+start+" and "+end+".");
        sc2.close();
    }
}

